# LEDGER//ONE Backend Environment Configuration Example
PROJECT_NAME="LEDGER//ONE — The Transaction Integrity Console"
PROJECT_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Currency
CURRENCY_CODE="USD"
CURRENCY_SYMBOL="$"

# Database Configuration:
# Lightweight zero-dependency SQLite for local development:
DATABASE_URL="sqlite:///./ledger_one.db"

# Production / Docker Compose PostgreSQL:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/ledger_one"

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
