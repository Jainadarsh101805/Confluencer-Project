# LEDGER//ONE — Global Environment Configuration Example

# Backend Settings
PROJECT_NAME="LEDGER//ONE — The Transaction Integrity Console"
PROJECT_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Currency
CURRENCY_CODE="USD"
CURRENCY_SYMBOL="$"

# Database:
# Default zero-dependency local SQLite:
DATABASE_URL="sqlite:///./ledger_one.db"
# Or PostgreSQL:
# DATABASE_URL="postgresql+psycopg://postgres:postgrespassword@localhost:5432/ledger_one"

# Frontend Settings
VITE_API_BASE_URL="http://localhost:8000/api/v1"
